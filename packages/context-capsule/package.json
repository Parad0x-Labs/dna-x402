{
  "name": "@parad0x_labs/context-capsule",
  "version": "1.2.0",
  "description": "Lossless agent session-history archive (zlib + SHA-256 Merkle root), a short prompt pointer, and on-demand keyword retrieval, for nulla-local and OpenClaw agents.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "src/index.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test tests/context-capsule.test.mjs",
    "bench:public": "node --experimental-strip-types scripts/bench-public.ts",
    "bench:scope": "node --experimental-strip-types scripts/bench-scope.ts",
    "bench:e2e:dry": "node --experimental-strip-types scripts/e2e-harness.ts --dry-run",
    "test:quality": "node --test tests/context-capsule-quality.test.mjs"
  },
  "keywords": [
    "llm", "context-compression", "ai-agents", "token-savings",
    "merkle", "zlib", "capsule", "nulla-local", "openclaw",
    "dna-x402", "parad0x-labs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Parad0x-Labs/dna-x402.git",
    "directory": "packages/context-capsule"
  },
  "homepage": "https://github.com/Parad0x-Labs/dna-x402/tree/main/packages/context-capsule",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  }
}
